# Copy to .env and fill in what you need. Everything is optional.

# --- AI assistant (any OpenAI-compatible endpoint) ---
# Default: the bundled Ollama container (free, local).
DQ_LLM_BASE_URL=http://ollama:11434/v1
DQ_LLM_MODEL=llama3.2:3b
DQ_LLM_API_KEY=
# Free hosted tiers instead (sample rows are then sent to that provider):
#   Groq:   DQ_LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini: DQ_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Email alerts (leave DQ_SMTP_HOST empty for dashboard-only) ---
# Gmail: turn on 2-step verification, create an App Password, use it below.
DQ_SMTP_HOST=
DQ_SMTP_PORT=587
DQ_SMTP_USER=
DQ_SMTP_PASSWORD=
DQ_ALERT_TO=
